<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:XamlToCSharpGenerator.Editor.Avalonia;assembly=XamlToCSharpGenerator.Editor.Avalonia"
             xmlns:ls="clr-namespace:XamlToCSharpGenerator.LanguageService.Models;assembly=XamlToCSharpGenerator.LanguageService"
             x:Class="EditorAvaloniaBrowserSample.MainView">
  <Grid RowDefinitions="40,*,180"
        Background="#F4F6F8">
    <Border Background="#FFFFFF"
            BorderBrush="#D6DEE8"
            BorderThickness="0,0,0,1"
            Padding="14,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="AXSG Browser Editor"
                   FontSize="15"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ElementName=Editor, Path=Diagnostics.Length, StringFormat='{}Problems: {0}'}"
                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Opacity="0.72" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="12"
            Background="#FFFFFF"
            BorderBrush="#D6DEE8"
            BorderThickness="1"
            ClipToBounds="True">
      <editor:AxamlTextEditor x:Name="Editor"
                              BorderThickness="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                              FontSize="13" />
    </Border>

    <Border Grid.Row="2"
            Background="#FFFFFF"
            BorderBrush="#D6DEE8"
            BorderThickness="0,1,0,0">
      <ListBox BorderThickness="0"
               ItemsSource="{Binding ElementName=Editor, Path=Diagnostics}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="ls:LanguageServiceDiagnostic">
            <Grid Margin="10,6"
                  ColumnDefinitions="92,*,96"
                  ColumnSpacing="12">
              <TextBlock Text="{Binding Severity}"
                         FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                         FontSize="12"
                         FontWeight="SemiBold" />
              <StackPanel Grid.Column="1"
                          Spacing="2">
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Code}"
                           FontSize="12"
                           Opacity="0.65" />
              </StackPanel>
              <StackPanel Grid.Column="2"
                          HorizontalAlignment="Right">
                <TextBlock Text="{Binding Range.Start.Line, StringFormat='{}Ln {0}'}"
                           FontSize="12"
                           HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Range.Start.Character, StringFormat='{}Col {0}'}"
                           FontSize="12"
                           Opacity="0.65"
                           HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
